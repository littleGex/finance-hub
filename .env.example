# Copy to .env and adjust.
FINANCE_HUB_DB=./data/finance.db
# Where payslip PDFs are filed (local runs). Docker uses NAS_PAYSLIP_PATH below instead.
PAYSLIP_DIR=./data/payslips
# "year" -> 2026/payslip_2026-03.pdf, "month" -> Mar/Entgeltabrechnung_2026-03.pdf
PAYSLIP_LAYOUT=year
# Where raw bank exports are archived after import.
IMPORT_ARCHIVE_DIR=./data/imports
# Manual FX rate: 1 GBP in EUR (no live feed in v0).
GBP_EUR=1.15
# Gamification targets
SAVINGS_RATE_TARGET=0.20
MONTHLY_BUDGET_EUR=3000

# Hostnames/IPs you open the app with (comma separated, no ports). localhost is always allowed.
# Requests for any other Host are rejected (protects against DNS rebinding).
ALLOWED_HOSTS=

# --- Docker (Pi) ---
# Host port; must not clash with other services on the Pi.
HOST_PORT=8094
# 0.0.0.0 = all interfaces. Set to the Pi's LAN IP to bind to that interface only.
BIND_ADDR=0.0.0.0
# Host folder of the NAS payslip archive, mounted into the container.
NAS_PAYSLIP_PATH=./data/payslips
# uid/gid the NAS share is mounted as.
PUID=1000
PGID=1000
